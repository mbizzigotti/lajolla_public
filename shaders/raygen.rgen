#version 460
#extension GL_EXT_ray_tracing : require

layout(set = 0, binding = 0) uniform accelerationStructureEXT topAS;
layout(set = 0, binding = 1, rgba8) writeonly uniform image2D img;
layout(location = 0) rayPayloadEXT vec3 payload;

void main() {
    uvec2 pix = gl_LaunchIDEXT.xy;
    vec2 resolution = vec2(800.0, 600.0);
    vec2 uv = (vec2(pix) + vec2(0.5)) / resolution * 2.0 - 1.0;
    uv.x *= resolution.x / resolution.y;
    vec3 origin = vec3(0.0, 0.0, 0.0);
    vec3 dir = normalize(vec3(uv.x, -uv.y, 1.0));
    traceRayEXT(topAS, gl_RayFlagsOpaqueEXT, 0xFF, 0, 0, 0, origin, 0.001, dir, 1000.0, 0);
    vec4 col = vec4(payload, 1.0);
    imageStore(img, ivec2(pix), col);
}
